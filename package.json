{
    "name": "pdf-compressor-pro",
    "version": "1.1.0",
    "description": "Compresor profesional de archivos PDF para Windows 10 y 11",
    "main": "dist-electron/main.js",
    "author": "PDF Compressor Pro Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TU_USUARIO_GITHUB/PDFR.git"
    },
    "scripts": {
        "dev": "vite",
        "build:react": "vite build",
        "build:electron": "tsc -p tsconfig.electron.json",
        "build": "npm run build:react && npm run build:electron",
        "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
        "dist": "npm run build && electron-builder --win",
        "dist:dir": "npm run build && electron-builder --dir"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "electron-updater": "^6.8.11",
        "lucide-react": "^0.460.0",
        "pako": "^2.1.0",
        "pdf-lib": "^1.17.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.5.4"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "@types/pako": "^2.0.3",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.1.0",
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.15",
        "typescript": "^5.6.3",
        "vite": "^5.4.11",
        "vite-plugin-electron": "^0.28.8",
        "wait-on": "^8.0.1"
    },
    "build": {
        "appId": "com.pdfcompressorpro.app",
        "productName": "PDF Compressor Pro",
        "copyright": "Copyright © 2026 PDF Compressor Pro",
        "directories": {
            "output": "release"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "TU_USUARIO_GITHUB",
                "repo": "PDFR"
            }
        ],
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "extraResources": [
            {
                "from": "resources/bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "PDF Compressor Pro",
            "differentialPackage": false
        }
    }
}
